# Traffic Monitor API – example environment
# Copy to .env and adjust as needed

# ── GPU (YOLO / PyTorch) ─────────────────────────────────────────────────────
# Kiểm tra: python -c "import torch; print(torch.__version__, torch.cuda.is_available())"
# Nếu có hậu tố +cpu -> PyTorch chỉ có CPU. Chọn wheel CUDA đúng Python tại https://pytorch.org/get-started/locally/
#
# Python 3.14 + GPU (RTX, v.v.): wheel CUDA là torch 2.11.x — cần ultralytics mới (repo đã pin >=8.4.46), rồi:
#   pip install -U ultralytics
#   pip install --force-reinstall torch torchvision --index-url https://download.pytorch.org/whl/cu126
# (gói ~2.6GB; yêu cầu driver NVIDIA đã cài)
#
# Python 3.11/3.12: thường thử --index-url https://download.pytorch.org/whl/cu124 (nếu PyTorch có bản cp31x tương ứng).
# Gợi ý thiết bị: cuda (mặc định trong app) | auto | cpu — máy torch CPU-only: YOLO_DEVICE=cpu
# YOLO_DEVICE=cuda
# Runtime backend: auto | torch | tensorrt
# - auto: ưu tiên .engine nếu có và CUDA khả dụng, fallback torch
# - tensorrt: ưu tiên TensorRT mạnh hơn (vẫn fallback torch nếu lỗi)
# YOLO_BACKEND=auto
# Tự export .pt -> .engine khi thiếu sidecar (cần TensorRT runtime)
# YOLO_TRT_AUTO_EXPORT=false
# YOLO_TRT_FP16=true
# YOLO_TRT_WORKSPACE_GB=4
# RTSP decode: mặc định bật CUDA (khi torch có CUDA). Máy không GPU: RTSP_HWACCEL=false
# RTSP_HWACCEL=true
# RTSP_HWACCEL_AUTO=true
# RTSP_CUDA_DEVICE=0
# RTSP_CUDA_EXTRA_FRAMES=16
# RTSP_D3D11_FALLBACK=true

# H264 WebSocket (BGR pipe → NVENC)
# H264_FFMPEG_GPU=0
# H264_NVENC_SURFACES=32
# H264_CUDA_PIPE_UPLOAD=true
# STREAM_CUDA_RESIZE=true

# YOLO ưu tiên GPU (máy CPU-only torch: đặt YOLO_DEVICE=cpu)
# YOLO_DEVICE=cuda

# Camera wall thumbnails (modal chọn camera) — giảm lag khi mở lưới preset
# THUMB_CACHE_TTL=25
# THUMB_MAX_CONCURRENT=2
# THUMB_FLUSH_FRAMES=12

# DeepStream (decode→nvinfer→nvenc toàn GPU): cần NVIDIA DeepStream SDK — chưa embed trong repo.

# Server
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated or leave default)
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Detection defaults
CONF_THRESHOLD=0.35
LINE_POSITION=0.55
MAX_FPS=30
# Preset gợi ý "max-fps balanced" cho máy tầm RTX 3050 Ti:
# MAX_FPS=20
# YOLO_BACKEND=tensorrt
# YOLO inference input size (smaller = faster, less accurate): 320|416|480|640
# YOLO_IMGSZ=320
# Stream output: giảm payload để mượt hơn
# STREAM_JPEG_QUALITY=58
# STREAM_MAX_WIDTH=800
# Skip N frames between YOLO inferences (0 = infer every frame; 1–3 giúp mượt hơn)
# INFERENCE_SKIP_FRAMES=3
# Flush N frames on RTSP before retrieve() (giảm lag buffer khi máy xử lý chậm)
# RTSP_FLUSH_FRAMES=1
# Companion RTSP (màn 2 LIVE) — FPS cap để 2 màn cân bằng
# COMPANION_MAX_FPS=20

# Auto-load this model on startup if present in models_storage (empty = skip)
DEFAULT_MODEL=best.pt

# Paths are relative to app working directory (e.g. backend/ when running locally)
# MODELS_DIR=models_storage
# UPLOADS_DIR=uploads

# ── Adaptive traffic light (ATCS) — tuning & safety
# See GET/PATCH /api/v1/traffic-light/atcs for runtime overrides without restart where supported.
#
# TLC_STOP_SPEED_PX_S=8
# TLC_MIN_STOPPED_FRAMES=5
# TLC_GAP_CLEAR_S=3
# TLC_EXTENSION_STEP_S=4
# TLC_NEAR_END_EXTEND_S=4
# TLC_EXTENSION_MIN_APPROACHING=2
# TLC_YELLOW_SECONDS=3
# TLC_ALL_RED_SECONDS=1.5
# TLC_MIN_GREEN=10
# TLC_MAX_GREEN=70
# TLC_MAX_RED_WAIT=90
# TLC_WAIT_PENALTY_MAX=15
# If true: gap-out only while the red approach still has stopped queue (classic fairness)
# TLC_GAP_REQUIRE_OPP_QUEUE=false
# If true: do not gap-out while the green ROW (or both sides for empty intersection) still has moving vehicles
# TLC_GAP_REQUIRE_ZERO_APPROACHING=true
# Half-band around counting line (fraction of frame height per side) for intersection occupancy; 0=off
# TLC_INTERSECTION_HALF_BAND_FRAC=0.035
# Block gap-out while any vehicle centroid is in that band
# TLC_GAP_REQUIRE_INTERSECTION_CLEAR=true
# Fuzzy extra green (sec) ≈ TLC_FUZZY_APPROACH_BOOST * approaching_count (capped)
# TLC_FUZZY_APPROACH_BOOST=0.55
# TLC_FUZZY_APPROACH_BOOST_MAX=14
# After all-red, prefer the approach that still has demand if the scheduled one is empty
# TLC_ACTUATED_PREFER_DEMAND_PHASE=true
# TLC_PRIORITY_WAIT_FRACTION=0.67
# Tune clearance after yellow (larger intersection → higher): TLC_ALL_RED_SECONDS=1.5
#
# ── Inverse phase inference (vehicle behavior → GREEN/RED/YELLOW guess)
# TLC_INFER_ENABLED=true
# TLC_INFER_CROSSING_WINDOW_S=3
# TLC_INFER_STOPPED_PX_S=8
# TLC_INFER_MOVING_PX_S=15
# TLC_INFER_GREEN_CROSS_PER_S=0.12
# TLC_INFER_GREEN_FRONT_PX_S=12
# TLC_INFER_MOVING_RATIO_GREEN=0.45
# TLC_INFER_RED_MAX_AVG_PX_S=6
# TLC_INFER_RED_CROSS_MAX=0.04
# TLC_INFER_YELLOW_MIN_CROSS=0.02
# TLC_INFER_MIN_PHASE_S=4
# TLC_INFER_HISTORY_LEN=8
#
# ── Cân thời gian xanh theo suy luận hai hướng (cùng một camera: trên/dưới vạch; chưa gộp 2 RTSP)
# TLC_INFER_BALANCE_ENABLED=false
# TLC_INFER_BALANCE_MAX_TRIM=12
# TLC_INFER_BALANCE_MIN_CONF=0.52
# TLC_INFER_BALANCE_QUEUE_OPP_FLOOR=3
# TLC_INFER_BALANCE_QUEUE_SLACK=2
#
# ── Hai làn / hai RTSP + crop đèn đỏ (pixel) ────────────────────────────────────
# Vung crop tren LUONG CHINH: y1,y2,x1,x2 (phân số frame 0–1). Đặt chồng lên bóng đèn.
# Rỗng = không ép “đỏ mới đếm” — gợi ý mật độ bật khi có ROI.
# TLC_SIGNAL_BBOX=
# Ngưỡng tỉ lệ pixel đỏ (HSV) trong crop để giữ cờ “đang đỏ” (có hysteresis).
# TLC_VISUAL_RED_ON_RATIO=0.065
# TLC_VISUAL_RED_OFF_RATIO=0.028
# Luồng phụ (POST /stream/start với companion_url): bbox đếm xe y1,y2,x1,x2; rỗng = cả khung.
# TLC_COMPANION_VEHICLE_BBOX=
